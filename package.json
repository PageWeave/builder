{
  "name": "pageweave-builder",
  "productName": "PageWeave Builder",
  "version": "0.1.0",
  "description": "Build PageWeave websites by chatting with a local agent.",
  "type": "module",
  "main": "./out/main/index.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/PageWeave/builder.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "sync:docs": "node scripts/sync-platform-docs.mjs",
    "test:e2e": "playwright test",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "0.3.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "daisyui": "5.7.50",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openid-client": "6.8.8",
    "pi-mcp-adapter": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stream-md": "0.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  },
  "author": "PageWeave"
}
